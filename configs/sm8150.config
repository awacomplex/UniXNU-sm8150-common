# SM8150 SoC 通用内核配置。
# arch:configs/common.config 已含 ARM_DT_PLATFORM/ARMCPU/NATIVE_ARCH_TIMER/NATIVE_PAN，
# 这里只放 SM8150 相关项。
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_ADRENO=n
# TODO(P2): SM8150 专用组件（UFS/DSI/GENI/SPMI/PMIC keys/TSENS）尚无组件仓库，
# 开发完成后在此启用：
# CONFIG_XNU_NATIVE_UFS=y
# CONFIG_XNU_NATIVE_GENI_SPI=y
# CONFIG_XNU_NATIVE_GENI_I2C=y
# CONFIG_XNU_NATIVE_QCOM_DSI=y
# CONFIG_XNU_NATIVE_SPMI=y
# CONFIG_XNU_NATIVE_PMIC_KEYS=y
# CONFIG_XNU_NATIVE_TSENS=y
