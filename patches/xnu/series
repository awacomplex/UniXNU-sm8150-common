# SM8150 XNU patch series（每行一个，按应用顺序）
#
# SM8150(骁龙855) 与 SM8550/SM7325 同为 8 核 3 簇(1+3+4) Qualcomm ARM64，
# MPIDR 布局一致。平台 patch 移植自 sm8550-common / sm7325-common 参考。

# SMP：MAX_CPUS 4→8 + MPIDR 在 Affinity1 编号核心（移植自 sm8550-common）
native-smp-secondary.patch

# 时钟：DT 平台从 cntfrq_el0 读 timebase 频率（而非 BCM2837 的 MMIO 默认值），
# 并给 bus/dec 频率计算加除零保护。移植自 sm7325-common。
native-armdt-clock.patch

# 定时器：NATIVE_ARCH_TIMER 时保留物理定时器（ArchTimer 用虚拟定时器 PPI，
# 不再需要禁用 CNTP）。arch 层 architectural-timer-entry.patch 只处理 start.s 的
# 中断路由，不覆盖 machine_routines.c 里的 CNTP_CTL 处理。移植自 sm7325-common。
native-virtual-timer-access.patch

